{
  "lsp": {
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": ["package.json"],
              "url": "https://www.schemastore.org/package",
            }
          ]
        }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "!deno", "..."]
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "!vtsls", "!deno", "..."]
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "!vtsls", "!deno", "..."]
    }
  }
}
